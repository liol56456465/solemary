{
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Read(/.env.test)",
      "Read(/.env.local)",
      "Read(/.env.*.local)",
      "Read(~/.config/mewvo/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(playwright|chrome-devtools)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/local-browser-only.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|Grep|Glob|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-env-secrets.mjs\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/node-check.mjs\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "stripe@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true
  }
}
