# Copy to .env.test (gitignored) and fill in the TEST bot values: a separate application
# in the Developer Portal, never the production Meowist bot (test mode refuses its
# CLIENT_ID and its token). Start with: npm run start:test   (.env is never read)

DISCORD_TOKEN=your_test_bot_token_here
CLIENT_ID=your_test_application_client_id
OWNER_IDS=

# Test mode: only TEST_GUILD_IDS exist for the bot, global commands are untouched,
# cron is off, the database must be local. Check with: npm run test:config
NODE_ENV=test
TEST_GUILD_IDS=your_test_main_server_id,your_test_support_server_id
TEST_ENABLE_CRON=false
LOG_LEVEL=info

# docker compose -f docker-compose.test.yml up -d
POSTGRES_URL=postgresql://meowist:meowist@localhost:5433/meowist_test
POSTGRES_SSL=false
AUTO_MIGRATE=true
SCHEMA_VERSION=2

PORT=3100

MAIN_GUILD_ID=your_test_main_server_id
SUPPORT_GUILD_ID=your_test_support_server_id
ADMIN_REQUEST_CHANNEL_ID=channel_id_in_test_main_server
SUPPORT_SERVER_INVITE=https://discord.gg/your_test_support_invite
APPEALS_CATEGORY_ID=category_id_in_test_support_server
MUTED_ROLE_ID=
# Optional staff channels in the test main server (each falls back to MOD_LOG_CHANNEL_ID).
MOD_LOG_CHANNEL_ID=
AUTOMOD_REVIEW_CHANNEL_ID=
BOT_ALERTS_CHANNEL_ID=

# Dashboard with the test bot (http://localhost:3100/dashboard). Add the redirect
# http://localhost:3100/dashboard/oauth/callback to the TEST application's OAuth2 page.
DASHBOARD_ENABLED=true
DASHBOARD_EDIT_ENABLED=true
DISCORD_CLIENT_SECRET=test_application_client_secret
PUBLIC_URL=http://localhost:3100
SESSION_SECRET=run_openssl_rand_hex_32
