# Copy this file to .env and replace placeholder values.

# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_application_client_id
# Your server ID (used in the setup tutorial; slash commands register globally via CLIENT_ID).
GUILD_ID=your_server_id
# Optional: comma-separated Discord user IDs
OWNER_IDS=

# Enforcement / appeals (validated at startup; production refuses to start if a required one is missing)
# Main Meowist server: /enforcements and /background are registered here only.
MAIN_GUILD_ID=your_main_server_id
# Meowist Support server: gets the appeal panel, and every command except the main-only ones.
SUPPORT_GUILD_ID=your_support_server_id
# Optional: MAIN-server category for appeal/report channels when /ticket has no ticket category set
# (defaults to the Meowist category). Users file appeals from the support server.
MAIN_APPEALS_CATEGORY_ID=
# Optional: channel where non-admins are sent to request a role (defaults to the Meowist channel).
ADMIN_REQUEST_CHANNEL_ID=
# Optional: permanent support-server invite shown in punishment DMs (defaults to the Meowist invite).
SUPPORT_SERVER_INVITE=
# Optional: existing muted role; the bot creates and remembers one when this is empty.
MUTED_ROLE_ID=
# Optional: role in the SUPPORT server given to members with an active main-server ban
# (defaults to the Meowist Banned role).
BANNED_ROLE_ID=
# Optional: MAIN-server roles for 1, 2 and 3+ active warnings, comma-separated (defaults to the Meowist roles).
WARN_ROLE_IDS=
# Optional: MAIN-server channel that gets a message for every enforcement action and appeal decision
# (defaults to the Meowist mod log channel).
MOD_LOG_CHANNEL_ID=

# Staff channels by purpose (all optional; each falls back to MOD_LOG_CHANNEL_ID, so one
# channel is enough):
#   MOD_LOG_CHANNEL_ID        one line for every enforcement action (manual and automatic).
#   AUTOMOD_REVIEW_CHANNEL_ID things that need a decision: automod review cards, member
#                             reports, held verifications. Low-severity automod hits are one
#                             compact line with an Undo button.
#   BOT_ALERTS_CHANNEL_ID     raids and lockdowns, staff guard, mass-action guard, auto slowmode,
#                             the daily automod digest (08:00 UTC), weekly reports.
AUTOMOD_REVIEW_CHANNEL_ID=
BOT_ALERTS_CHANNEL_ID=
# Channels automod ignores, comma-separated (more can be added with /automod exempt).
AUTOMOD_EXEMPT_CHANNEL_IDS=
# Extra words for the language filter, comma-separated.
AUTOMOD_EXTRA_WORDS=

# OAuth verification: the Verify button sends a "Verify with Discord" link instead
# of giving the role directly. Needs both of these; add <PUBLIC_URL>/oauth/callback
# under OAuth2 → Redirects in the Discord Developer Portal.
DISCORD_CLIENT_SECRET=
PUBLIC_URL=https://your-app.replit.app
# 64 hex characters (openssl rand -hex 32). Encrypts the stored OAuth tokens; without
# it tokens are not stored, so guilds.join cannot be used later.
OAUTH_TOKEN_KEY=
# Optional: where the browser goes after verifying (default: the Meowist invite).
VERIFY_SUCCESS_REDIRECT=

# Bot Runtime Configuration
NODE_ENV=production
LOG_LEVEL=warn
LOG_TO_FILE=false
SENTRY_DSN=

# Web/API Configuration
PORT=3000
WEB_HOST=0.0.0.0
PORT_RETRY_ATTEMPTS=5
CORS_ORIGIN=*

# PostgreSQL Configuration (Primary Database)
# Railway: use the private POSTGRES_URL / DATABASE_URL variable (includes SSL).
# Public proxy logs showing "invalid length of startup packet" or "SSL without ALPN"
# are usually internet scanners — not your bot.
POSTGRES_URL=postgresql://postgres:yourpassword@localhost:5432/titanbot
# Supabase: use the SESSION pooler URL from Connect (port 5432, user postgres.<ref>),
# not the direct db.<ref>.supabase.co host (IPv6-only on Free) and not port 6543.
# TLS: remote hosts are always verified. Supabase signs with its own root, so give its
# CA (Dashboard → Database Settings → SSL → prod-ca-2021.crt) as PEM text or a file:
POSTGRES_CA_CERT=
POSTGRES_CA_FILE=
# POSTGRES_SSL: leave empty. "no-verify" only for a provider with a self-signed cert.
POSTGRES_SSL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=titanbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword

# PostgreSQL Pool/Timeout Settings (Supabase Free session pooler allows ~15 clients: use 10)
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_MIN_CONNECTIONS=0
POSTGRES_CONNECTION_TIMEOUT=10000
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_RETRIES=3
POSTGRES_BACKOFF_BASE=100
POSTGRES_BACKOFF_MULTIPLIER=2

# Migration & Schema Settings
AUTO_MIGRATE=true
POSTGRES_MIGRATION_TABLE=schema_migrations
SCHEMA_VERSION=2
SCHEMA_VERSION_LABEL=baseline-v2

# Backup/Restore Script Settings
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
POSTGRES_RESTORE_URL=

# Optional: override nodes as JSON array (takes priority over nodes file)
# Self-hosted single node fallback (used only if nodes file/env array are absent):

# Optional Feature/API Keys
TMDB_API_KEY=
